{
  "name": "gifhop",
  "private": true,
  "version": "1.0.0-rc.5",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs && node test-exporters.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "vite": "8.3.5"
  },
  "description": "Free open-source desktop animation studio powered by your local Codex CLI",
  "main": "desktop/main.mjs",
  "author": "Bavoch",
  "license": "MIT",
  "homepage": "https://github.com/Bavoch/GifHop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bavoch/GifHop.git"
  },
  "bugs": {
    "url": "https://github.com/Bavoch/GifHop/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
